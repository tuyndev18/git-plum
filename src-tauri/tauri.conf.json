{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "git-plum",
  "version": "0.1.0",
  "identifier": "dev.gitplum.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "git-plum",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.gravatar.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "copyright": "git-plum contributors",
    "category": "DeveloperTool",
    "shortDescription": "Ứng dụng desktop quản lý repository Git",
    "longDescription": "git-plum là ứng dụng desktop mã nguồn mở để quản lý repository Git bằng giao diện đồ hoạ, tập trung vào tốc độ đọc lịch sử và chất lượng đồ thị nhánh."
  }
}
